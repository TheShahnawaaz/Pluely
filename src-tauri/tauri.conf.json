{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pluely",
  "version": "0.1.0",
  "identifier": "com.pluely.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && node scripts/collect-licenses.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Pluely",
        "width": 1180,
        "height": 820,
        "minWidth": 850,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' asset: http://asset.localhost data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/pluely-transcribe"
    ],
    "category": "Productivity",
    "shortDescription": "Your conversations. Your intelligence.",
    "copyright": "2026 Pluely Contributors; see THIRD_PARTY_NOTICES.md for assets.",
    "macOS": {
      "minimumSystemVersion": "14.2",
      "infoPlist": "Info.plist",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "displayLanguageSelector": false
      }
    },
    "resources": {
      "../THIRD_PARTY_NOTICES.md": "licenses/THIRD_PARTY_NOTICES.md",
      "../THIRD_PARTY_LICENSES.txt": "licenses/THIRD_PARTY_LICENSES.txt",
      "../public/assets/OFL-Inter.txt": "licenses/OFL-Inter.txt"
    }
  }
}
